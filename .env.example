# Proposed names. The agent must wire and document them during implementation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DATA_MODE=demo
WORDPRESS_BASE_URL=https://commerce.example.com
WOOCOMMERCE_STORE_API_PATH=/wp-json/wc/store/v1
PETFOOD_PLUGIN_API_PATH=/wp-json/petfood/v1
# Server-only keys; supply cryptographically random values outside source control.
PETFOOD_HANDOFF_SECRET=
CART_COOKIE_ENCRYPTION_KEY=
# Allowlisted hostname, never user controlled.
COMMERCE_ALLOWED_HOST=commerce.example.com
CATALOG_CACHE_SECONDS=60
# No privileged WooCommerce REST keys needed by default public catalog/cart flow.
# Add server-only credentials only for a documented privileged integration.
